# Application environment (development, production, etc.)
APP_ENV=development

# Application configuration
VERSION=1.0.0
PORT=6020
DEBUG_MODE=true

# JWT Configuration
JWT_SECRET=mc-manage-secret-change-in-production
JWT_EXPIRATION_HOURS=24
